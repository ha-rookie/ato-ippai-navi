{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ato-ippai-api-poc",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MAX_LATE_TRANSIT_WAIT_MINUTES": "90"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
